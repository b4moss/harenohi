{
  "name": "@b4moss/harenohi",
  "version": "0.4.2",
  "description": "祝日演算ライブラリ（当面は日本の祝日）",
  "type": "module",
  "license": "MIT",
  "author": "Kohki SHIKATA <kohki.shikata@gmail.com>",
  "homepage": "https://github.com/b4moss/harenohi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4moss/harenohi.git"
  },
  "bugs": {
    "url": "https://github.com/b4moss/harenohi/issues"
  },
  "keywords": [
    "holiday",
    "japan",
    "calendar"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.js"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "import": "./dist/locales/en.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "fetch:jp-holiday": "node scripts/fetch-jp-holiday-csv.mjs",
    "parse:jp-holiday": "node scripts/parse-jp-holiday-csv.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.37.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
